{
  "description": "Schutzregeln: Prozesse nicht nach Namen beenden, Prod-Checkouts nur per Deploy, nie direkt auf main",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
